# Copy this file to an ignored .env file on the target machine, fill only
# MIR_APIYI_API_KEY, then run: source .env.apiyi

export MIR_PROJECT_ROOT="${MIR_PROJECT_ROOT:-$(pwd)}"
export MIR_SOURCES_CONFIG_FILE="$MIR_PROJECT_ROOT/configs/sources.apiyi.yaml"
export MIR_APIYI_API_KEY=""
export MIR_APIYI_BASE_URL="https://api.morewater.vip/v1"
export MIR_APIYI_TIMEOUT="300"
